# Core app config
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
DATABASE_URL=sqlite:///./cadfactory.db

# Upload storage
UPLOAD_DIR=./uploads
MAX_FILE_MB=50

# Optional AI integration (leave empty to use fallback analysis)
GEMINI_API_KEY=

